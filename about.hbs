<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>FreakyMate: third-party licenses</title>
  <style>
    body { font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.4; }
    pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 0.85rem; }
    li { margin-bottom: 0.2rem; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>
    FreakyMate is licensed under GPL-3.0-or-later (see LICENSE). The binary contains the following crates
    under their own licenses.
  </p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>License texts</h2>
  {{#each licenses}}
  <section>
    <h3 id="{{id}}">{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
