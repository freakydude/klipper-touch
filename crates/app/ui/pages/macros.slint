// Makros aus der Klipper-Konfiguration (ohne Hilfsmakros mit `_`).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Confirm, Printer } from "../state.slint";
import { IconButton } from "../components/controls.slint";

export component MacrosPage inherits Rectangle {
    property <int> columns: 3;
    property <length> tile-height: 72px;
    property <length> cell-width: (list.width - (root.columns - 1) * Theme.spacing) / root.columns;

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        list := Flickable {
            horizontal-stretch: 1;
            content-height: max(self.height, ceil(Printer.macros.length / root.columns) * (root.tile-height + Theme.spacing));
            for macro[index] in Printer.macros: IconButton {
                x: mod(index, root.columns) * (root.cell-width + Theme.spacing);
                y: floor(index / root.columns) * (root.tile-height + Theme.spacing);
                width: root.cell-width;
                height: root.tile-height;
                icon: Icons.nav-macros;
                text: macro;
                icon-size: 24px;
                enabled: !Printer.is-printing || macro != "PRINT_START";
                clicked => { Confirm.ask(@tr("Run macro"), macro, "run-macro", macro, false); }
            }
        }

        if Printer.macros.length == 0: Text {
            text: @tr("No macros found in the Klipper configuration.");
            color: Theme.muted;
            vertical-alignment: center;
        }

        VerticalLayout {
            width: 80px;
            spacing: Theme.spacing;
            IconButton {
                icon: Icons.ui-chevron-up;
                enabled: list.content-y < 0;
                clicked => { list.content-y = min(0px, list.content-y + list.height * 0.8); }
            }
            IconButton {
                icon: Icons.ui-chevron-down;
                enabled: list.content-y > list.height - list.content-height;
                clicked => { list.content-y = max(list.height - list.content-height, list.content-y - list.height * 0.8); }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
