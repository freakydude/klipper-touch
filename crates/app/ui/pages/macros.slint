// Macros from the Klipper configuration (without helper macros starting with `_`).

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Confirm, Printer } from "../state.slint";
import { IconButton, ScrollList } from "../components/controls.slint";

export component MacrosPage inherits Rectangle {
    property <int> columns: 3;
    property <length> tile-height: 72px;
    property <length> cell-width: (list.row-width - (root.columns - 1) * Theme.spacing) / root.columns;

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        list := ScrollList {
            horizontal-stretch: 1;
            content-height: ceil(Printer.macros.length / root.columns) * (root.tile-height + Theme.spacing);
            for macro[index] in Printer.macros: IconButton {
                x: mod(index, root.columns) * (root.cell-width + Theme.spacing);
                y: floor(index / root.columns) * (root.tile-height + Theme.spacing);
                width: root.cell-width;
                height: root.tile-height;
                icon: Icons.nav-macros;
                text: macro;
                icon-size: 24px;
                enabled: !Printer.is-printing || macro != "PRINT_START";
                clicked => { Confirm.ask(@tr("Run macro"), macro, "run-macro", macro, false); }
            }
        }

        if Printer.macros.length == 0: Text {
            text: @tr("No macros found in the Klipper configuration.");
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
}
