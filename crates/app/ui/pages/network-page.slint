// The Network tab of the system pages: Wi-Fi and Ethernet of the printer host.

import { Theme } from "../theme.slint";
import { Network } from "../state.slint";
import { NetworkSection } from "network.slint";
import { SystemTabs } from "../components/system-tabs.slint";

export component NetworkPage inherits Rectangle {
    init => {
        Network.refresh();
        Network.scan();
    }

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;
        SystemTabs { }
        NetworkSection { vertical-stretch: 1; }
    }
}
