// Temperatures, presets and part cooling fan.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, HeaterItem, Printer, UiSettings } from "../state.slint";
import { Card, IconButton, StepSelector, TouchSlider } from "../components/controls.slint";

component HeaterRow inherits Rectangle {
    in property <HeaterItem> heater;
    in property <float> step;
    height: 64px;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.heater.object == "heater_bed" ? Icons.thermal-bed : root.heater.object == "extruder" ? Icons.thermal-nozzle : Icons.thermal-chamber;
                colorize: root.heater.target > 0 ? Theme.accent : Theme.muted;
                width: 28px;
                height: 28px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.heater.label;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
            Text {
                text: root.heater.temperature.to-fixed(1) + " °C";
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 600;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 80px;
            Text {
                text: @tr("Target");
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
            }
            Text {
                text: root.heater.target > 0 ? round(root.heater.target) + " °C" : @tr("off");
                color: root.heater.target > 0 ? Theme.accent : Theme.muted;
                font-size: Theme.font-large;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        IconButton {
            width: 64px;
            icon: Icons.ui-minus;
            enabled: root.heater.target > 0;
            clicked => { Actions.step-heater(root.heater.object, -root.step); }
        }
        IconButton {
            width: 64px;
            icon: Icons.ui-plus;
            enabled: root.heater.can-raise;
            clicked => { Actions.step-heater(root.heater.object, root.step); }
        }
        IconButton {
            width: 64px;
            icon: Icons.thermal-off;
            enabled: root.heater.target > 0;
            clicked => { Actions.set-heater(root.heater.object, 0); }
        }
    }
}

export component TemperaturePage inherits Rectangle {
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                for heater in Printer.heaters: HeaterRow {
                    heater: heater;
                    step: UiSettings.temperature-step;
                }
                if Printer.sensors.length > 0: Card {
                    title: @tr("Sensors");
                    icon: Icons.thermal-heating;
                    HorizontalLayout {
                        spacing: 16px;
                        for sensor in Printer.sensors: Text {
                            text: sensor.label + ": " + sensor.temperature.to-fixed(1) + " °C";
                            color: Theme.foreground;
                            font-size: Theme.font-small;
                        }
                    }
                }
                if Printer.has-part-fan: Card {
                    title: @tr("Part fan: {}%", round(fan-slider.shown));
                    icon: Icons.thermal-fan;
                    HorizontalLayout {
                        spacing: Theme.spacing;
                        IconButton {
                            width: 72px;
                            text: @tr("Off");
                            checked: Printer.part-fan < 1;
                            clicked => { Actions.set-part-fan(0); }
                        }
                        fan-slider := TouchSlider {
                            horizontal-stretch: 1;
                            value: Printer.part-fan;
                            changed(level) => { Actions.set-part-fan(level); }
                        }
                        IconButton {
                            width: 72px;
                            text: "100%";
                            checked: Printer.part-fan > 99;
                            clicked => { Actions.set-part-fan(100); }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            VerticalLayout {
                width: 120px;
                spacing: Theme.spacing;
                for preset[index] in UiSettings.presets: IconButton {
                    icon: Icons.thermal-preset;
                    text: preset.name + "  " + round(preset.extruder) + "/" + round(preset.bed);
                    clicked => { Actions.apply-preset(index); }
                }
                IconButton {
                    icon: Icons.thermal-cooling;
                    text: @tr("Cool down");
                    kind: "accent";
                    clicked => { Actions.cool-down(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        StepSelector {
            label: @tr("Step");
            values: [1, 5, 10, 25];
            unit: " °C";
            selected <=> UiSettings.temperature-step;
            changed => { UiSettings.steps-changed(); }
        }
    }
}
