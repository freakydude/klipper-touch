// Temperatures, presets and part cooling fan.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Display, HeaterItem, Printer, UiSettings } from "../state.slint";
import { Card, IconButton, StepSelector, TouchSlider } from "../components/controls.slint";

component HeaterRow inherits Rectangle {
    in property <HeaterItem> heater;
    in property <float> step;
    in property <length> row-height: 60px;
    // Narrow displays: slimmer target block and buttons.
    in property <bool> compact;
    height: root.row-height;
    background: Theme.surface;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding: 4px;
        padding-left: 10px;
        spacing: Theme.spacing;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.heater.object == "heater_bed" ? Icons.thermal-bed : root.heater.object == "extruder" ? Icons.thermal-nozzle : Icons.thermal-chamber;
                colorize: root.heater.target > 0 ? Theme.accent : Theme.muted;
                width: 28px;
                height: 28px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.heater.label;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
            Text {
                text: root.heater.temperature.to-fixed(1) + " °C";
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 600;
            }
        }
        VerticalLayout {
            alignment: center;
            width: root.compact ? 64px : 80px;
            Text {
                text: @tr("Target");
                color: Theme.muted;
                font-size: Theme.font-small;
                horizontal-alignment: center;
            }
            Text {
                text: root.heater.target > 0 ? round(root.heater.target) + " °C" : @tr("off");
                color: root.heater.target > 0 ? Theme.accent : Theme.muted;
                font-size: Theme.font-large;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        IconButton {
            width: root.compact ? 52px : 64px;
            icon: Icons.ui-minus;
            enabled: root.heater.target > 0;
            clicked => { Actions.step-heater(root.heater.object, -root.step); }
        }
        IconButton {
            width: root.compact ? 52px : 64px;
            icon: Icons.ui-plus;
            enabled: root.heater.can-raise;
            clicked => { Actions.step-heater(root.heater.object, root.step); }
        }
        IconButton {
            width: root.compact ? 52px : 64px;
            icon: Icons.thermal-off;
            enabled: root.heater.target > 0;
            clicked => { Actions.set-heater(root.heater.object, 0); }
        }
    }
}

// Off, slider and 100 % for the part fan; in a card on normal displays, on one line on compact ones.
component FanControl inherits HorizontalLayout {
    out property <float> shown: fan-slider.shown;
    spacing: Theme.spacing;
    IconButton {
        width: 72px;
        text: @tr("Off");
        checked: Printer.part-fan < 1;
        clicked => { Actions.set-part-fan(0); }
    }
    fan-slider := TouchSlider {
        horizontal-stretch: 1;
        value: Printer.part-fan;
        changed(level) => { Actions.set-part-fan(level); }
    }
    IconButton {
        width: 72px;
        text: "100%";
        checked: Printer.part-fan > 99;
        clicked => { Actions.set-part-fan(100); }
    }
}

export component TemperaturePage inherits Rectangle {
    // Displays up to 400 px high (640x400) get tighter rows and no sensor line, so the step selector stays visible.
    property <bool> compact: Display.compact;

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        HorizontalLayout {
            spacing: Theme.spacing;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.spacing;
                for heater in Printer.heaters: HeaterRow {
                    heater: heater;
                    step: UiSettings.temperature-step;
                    row-height: root.compact ? 52px : 60px;
                    compact: root.compact;
                }
                // One line instead of a card: the page has to fit three heaters, the sensors and the fan on 800x480.
                if Printer.sensors.length > 0 && !root.compact: HorizontalLayout {
                    spacing: 16px;
                    height: 22px;
                    padding-left: 4px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: Icons.thermal-heating; colorize: Theme.muted; width: 18px; height: 18px; }
                    }
                    for sensor in Printer.sensors: Text {
                        text: sensor.label + ": " + sensor.temperature.to-fixed(1) + " °C";
                        color: Theme.foreground;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }
                if Printer.has-part-fan && !root.compact: Card {
                    title: @tr("Part fan: {}%", round(fan.shown));
                    icon: Icons.thermal-fan;
                    fan := FanControl { }
                }
                if Printer.has-part-fan && root.compact: FanControl {
                    height: 52px;
                }
                Rectangle { vertical-stretch: 1; }
            }

            VerticalLayout {
                width: 120px;
                spacing: Theme.spacing;
                for preset[index] in UiSettings.presets: IconButton {
                    icon: Icons.thermal-preset;
                    // Compact: a smaller icon keeps the five buttons within the height of a 400 px display.
                    icon-size: root.compact ? 18px : Theme.icon;
                    min-height: root.compact ? 44px : Theme.touch;
                    text: preset.name + "  " + round(preset.extruder) + "/" + round(preset.bed);
                    clicked => { Actions.apply-preset(index); }
                }
                IconButton {
                    icon: Icons.thermal-cooling;
                    icon-size: root.compact ? 18px : Theme.icon;
                    min-height: root.compact ? 44px : Theme.touch;
                    text: @tr("Cool down");
                    kind: "accent";
                    clicked => { Actions.cool-down(); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        StepSelector {
            label: @tr("Step");
            values: [1, 5, 10, 25];
            unit: " °C";
            selected <=> UiSettings.temperature-step;
            changed => { UiSettings.steps-changed(); }
        }
    }
}
