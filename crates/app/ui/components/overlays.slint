// Overlays: confirmation, messages flyout, on-screen keyboard and text entry.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Page, Printer, SpoolPicker } from "../state.slint";
import { ColorBar, IconButton, ScrollList } from "controls.slint";

// Dimming background that intercepts input meant for elements underneath.
component Scrim inherits Rectangle {
    background: #000000b0;
    TouchArea { }

    @children
}

export component ConfirmDialog inherits Scrim {
    visible: Confirm.open;

    Rectangle {
        width: min(parent.width - 80px, 480px);
        height: min(parent.height - 24px, 270px);
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Confirm.danger ? Theme.danger : Theme.border;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: Confirm.title;
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: Confirm.message;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                spacing: 12px;
                IconButton {
                    icon: Icons.ui-back;
                    text: @tr("Back");
                    horizontal: true;
                    clicked => { Confirm.open = false; }
                }

                IconButton {
                    icon: Confirm.danger ? Icons.ui-warning : Icons.ui-check;
                    text: @tr("Confirm");
                    kind: Confirm.danger ? "danger" : "accent";
                    horizontal: true;
                    clicked => { Confirm.execute(); }
                }
            }
        }
    }
}

// Flyout below the status bar with all errors and informations, newest first. Tapping outside closes it.
export component MessagesFlyout inherits Rectangle {
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { Navigation.messages-open = false; }
    }

    Rectangle {
        x: root.width - self.width - 8px;
        y: 52px;
        width: min(560px, root.width - 16px);
        height: root.height - 60px;
        // Slightly see-through, so it is clear that the flyout lies over the page.
        background: Theme.surface.with-alpha(Theme.flyout-opacity);
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                height: Theme.touch;
                Text {
                    horizontal-stretch: 1;
                    text: @tr("Messages");
                    color: Theme.foreground;
                    font-size: Theme.font-large;
                    vertical-alignment: center;
                }
                IconButton {
                    width: Theme.touch;
                    icon: Icons.ui-close;
                    accessible-label: @tr("Close");
                    clicked => { Navigation.messages-open = false; }
                }
            }

            messages-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.messages-height;
                for message in Printer.messages: Rectangle {
                    x: 0;
                    y: message.top;
                    width: messages-list.row-width;
                    height: message.height;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    // The text takes the full width; the time is small, below it on the right.
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Rectangle {
                            width: 4px;
                            background: message.is-error ? Theme.danger : Theme.info;
                            border-radius: 2px;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                vertical-stretch: 1;
                                text: message.text;
                                color: message.is-error ? Theme.danger : Theme.foreground;
                                font-size: Theme.font-normal;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                            Text {
                                height: 16px;
                                text: message.time;
                                color: Theme.muted;
                                font-size: Theme.font-small;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }

            // Flat and wide: the height belongs to the messages, the width keeps the buttons easy to hit.
            HorizontalLayout {
                spacing: Theme.spacing;
                height: 44px;
                IconButton {
                    text: @tr("Discard all");
                    icon: Icons.ui-delete;
                    icon-size: 20px;
                    horizontal: true;
                    min-height: 44px;
                    clicked => { Actions.messages-clear(); }
                }
                IconButton {
                    text: @tr("Console");
                    icon: Icons.nav-console;
                    icon-size: 20px;
                    horizontal: true;
                    min-height: 44px;
                    kind: "accent";
                    clicked => {
                        Navigation.page = Page.console;
                        Navigation.messages-open = false;
                    }
                }
            }
        }
    }
}

component Key inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback pressed;
    min-width: 40px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: key-touch.pressed ? Theme.accent : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.label;

    key-touch := TouchArea {
        clicked => { root.pressed(); }
    }

    if root.icon.width > 0: Image {
        source: root.icon;
        colorize: Theme.foreground;
        width: 22px;
        height: 22px;
    }
    if root.icon.width == 0: Text {
        text: root.label;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// On-screen keyboard for devices without a physical keyboard. It only reports the keys; the text field edits itself.
export component OnScreenKeyboard inherits VerticalLayout {
    in-out property <bool> upper: true;
    in-out property <bool> symbols;
    // A character key (the text on it), backspace and enter.
    callback typed(string);
    callback backspace;
    callback enter;

    property <[[string]]> lower-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "="],
        ["z", "x", "c", "v", "b", "n", "m", ".", "-", "_"],
    ];
    property <[[string]]> upper-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L", "="],
        ["Z", "X", "C", "V", "B", "N", "M", ".", "-", "_"],
    ];
    property <[[string]]> symbol-rows: [
        ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"],
        ["+", "=", "?", "'", "\"", ",", ";", "<", ">", "|"],
        ["[", "]", "{", "}", "\\", "~", "`", "€", "§", "°"],
        ["ä", "ö", "ü", "ß", "Ä", "Ö", "Ü", ".", "-", "_"],
    ];

    spacing: 4px;

    for row in (root.symbols ? root.symbol-rows : root.upper ? root.upper-rows : root.lower-rows): HorizontalLayout {
        spacing: 4px;
        height: 40px;
        for key in row: Key {
            label: key;
            pressed => { root.typed(key); }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        height: 40px;
        Key {
            label: root.upper ? "abc" : "ABC";
            horizontal-stretch: 2;
            pressed => {
                root.symbols = false;
                root.upper = !root.upper;
            }
        }

        Key {
            label: root.symbols ? "abc" : "#+=";
            horizontal-stretch: 2;
            pressed => { root.symbols = !root.symbols; }
        }

        Key {
            label: ":";
            pressed => { root.typed(":"); }
        }

        Key {
            label: "/";
            pressed => { root.typed("/"); }
        }

        Key {
            label: "space";
            horizontal-stretch: 3;
            pressed => { root.typed(" "); }
        }

        Key {
            label: "backspace";
            icon: Icons.ui-chevron-left;
            horizontal-stretch: 2;
            pressed => { root.backspace(); }
        }

        Key {
            label: "enter";
            icon: Icons.ui-check;
            horizontal-stretch: 2;
            pressed => { root.enter(); }
        }
    }
}

// Full-screen text entry with on-screen keyboard; `secret` hides the input (passwords). The field is Slint's own
// `TextInput`: cursor, selection, Home/End, Delete, Backspace, Ctrl+C/V and the like come from it, for the physical
// keyboard and, as key presses, for the on-screen keys alike.
export component TextEntryDialog inherits Scrim {
    in property <string> title;
    in property <bool> secret;
    in-out property <string> text;
    in-out property <bool> open;
    callback accepted(string);
    property <bool> reveal;
    visible: root.open;

    function close() {
        root.reveal = false;
        root.open = false;
    }

    changed open => {
        if (root.open) {
            field.focus();
            field.select-all();
        }
    }

    FocusScope {
        width: parent.width;
        height: parent.height;
        // Escape closes the dialog; every other key is for the field.
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            background: Theme.surface;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 48px;
                    Text {
                        text: root.title;
                        color: Theme.muted;
                        font-size: Theme.font-normal;
                        vertical-alignment: center;
                        max-width: 260px;
                        overflow: elide;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.background;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.accent;
                        clip: true;
                        forward-focus: field;
                        field := TextInput {
                            // Keeps the cursor in view when the text is longer than the field.
                            property <length> computed-x;
                            x: 8px + min(0px, max(parent.width - 16px - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - 16px - self.text-cursor-width, self.preferred-width);
                            height: 100%;
                            single-line: true;
                            vertical-alignment: center;
                            text <=> root.text;
                            color: Theme.foreground;
                            font-size: Theme.font-large;
                            input-type: root.secret && !root.reveal ? InputType.password : InputType.text;
                            accepted => {
                                root.close();
                                root.accepted(root.text);
                            }
                            cursor-position-changed(position) => {
                                if (position.x + self.computed-x < 0px) {
                                    self.computed-x = -position.x;
                                } else if (position.x + self.computed-x > parent.width - 16px - self.text-cursor-width) {
                                    self.computed-x = parent.width - 16px - position.x - self.text-cursor-width;
                                }
                            }
                        }
                    }

                    if root.secret: IconButton {
                        icon: root.reveal ? Icons.ui-unlock : Icons.ui-lock;
                        width: 56px;
                        checked: root.reveal;
                        accessible-label: @tr("Show password");
                        clicked => { root.reveal = !root.reveal; }
                    }
                    IconButton {
                        icon: Icons.ui-close;
                        width: 56px;
                        clicked => { root.close(); }
                    }
                }

                OnScreenKeyboard {
                    vertical-stretch: 1;
                    typed(key) => { Actions.press-key(key); }
                    backspace => { Actions.press-key(Key.Backspace); }
                    enter => { Actions.press-key(Key.Return); }
                }
            }
        }
    }
}

// Parameters of a macro: one field per parameter, Klipper defaults as placeholders. Running asks for confirmation.
export component MacroFormDialog inherits Scrim {
    in-out property <bool> open;
    property <int> edit-index: -1;
    visible: root.open;

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 48px;
                Text {
                    horizontal-stretch: 1;
                    text: Printer.macro-form-name;
                    color: Theme.foreground;
                    font-size: Theme.font-large;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Each parameter is an input field: its name on the left, the value (or the Klipper default in grey) on the right.
            params-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.macro-form.length * (Theme.touch + Theme.spacing);
                for param[index] in Printer.macro-form: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: params-list.row-width - 16px;
                    height: Theme.touch;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: param.name;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            horizontal-stretch: 2;
                            background: Theme.background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: param.value != "" ? param.value : param.placeholder;
                                color: param.value != "" ? Theme.foreground : Theme.disabled-foreground;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.edit-index = index;
                            edit.title = param.name;
                            edit.text = param.value;
                            edit.open = true;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    text: @tr("Cancel");
                    clicked => { root.open = false; }
                }
                IconButton {
                    text: @tr("Run");
                    icon: Icons.ui-check;
                    kind: "accent";
                    // Running is the confirmation: the user has just seen every parameter.
                    clicked => {
                        Actions.run-macro(Actions.macro-form-script());
                        root.open = false;
                    }
                }
            }
        }
    }

    edit := TextEntryDialog {
        accepted(text) => { Actions.set-macro-param(root.edit-index, text); }
    }
}

// Objects of the running print. Tapping one asks first; an excluded object cannot be printed again.
export component ExcludeObjectsDialog inherits Scrim {
    in-out property <bool> open;
    visible: root.open;

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                height: 48px;
                text: @tr("Exclude objects");
                color: Theme.foreground;
                font-size: Theme.font-large;
                vertical-alignment: center;
            }
            objects-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.print-objects.length * (Theme.touch + Theme.spacing);
                for item[index] in Printer.print-objects: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: objects-list.row-width - 16px;
                    height: Theme.touch;
                    background: item.excluded ? Theme.background : Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: item.name;
                            color: item.excluded ? Theme.disabled-foreground : Theme.foreground;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: item.excluded ? @tr("Excluded") : "";
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        enabled: !item.excluded;
                        clicked => {
                            Confirm.ask(@tr("Exclude object"), item.name, "exclude-object", item.name, false);
                            root.open = false;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    text: @tr("Close");
                    clicked => { root.open = false; }
                }
            }
        }
    }
}

// Picks a spool of Spoolman for the gate (or, without MMU, as the active spool), weighs it, or takes it out of the gate.
// The list shows the spools in a lane first, then the most recently used ones.
export component SpoolDialog inherits Scrim {
    property <int> selected: -1;
    visible: SpoolPicker.open;

    changed visible => {
        if (!self.visible) { root.selected = -1; }
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: SpoolPicker.gate >= 0 ? @tr("Spool for gate {}", SpoolPicker.gate) : @tr("Spool in use");
                    color: Theme.foreground;
                    font-size: Theme.font-large;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if Printer.spoolman-offline: Text {
                    text: Printer.spoolman-pending > 0 ? @tr("Spoolman offline, {} reports waiting", Printer.spoolman-pending) : @tr("Spoolman offline");
                    color: Theme.warning;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
            spools-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.spools.length * (Theme.touch + Theme.spacing);
                for spool[index] in Printer.spools: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: spools-list.row-width - 16px;
                    height: Theme.touch;
                    background: spool.id == root.selected ? Theme.surface-active : Theme.surface-raised;
                    border-radius: Theme.radius;
                    border-width: spool.id == root.selected ? 2px : 0px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            ColorBar {
                                width: 14px;
                                height: 34px;
                                vertical: true;
                                first: spool.color;
                                second: spool.color-2;
                                third: spool.color-3;
                                count: spool.color-count;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: spool.title;
                                color: Theme.foreground;
                                font-size: Theme.font-normal;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: spool.detail;
                                color: spool.low ? Theme.warning : Theme.muted;
                                font-size: Theme.font-small;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: spool.place;
                            color: Theme.accent;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.selected = spool.id; }
                    }
                }
            }
            if Printer.spools.length == 0: Text {
                text: Printer.spools-loading ? @tr("Loading") : @tr("No spools");
                color: Theme.muted;
                font-size: Theme.font-normal;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    icon: Icons.ui-close;
                    text: @tr("Close");
                    horizontal: true;
                    clicked => { SpoolPicker.open = false; }
                }
                if SpoolPicker.gate >= 0: IconButton {
                    text: @tr("Remove");
                    horizontal: true;
                    clicked => {
                        Actions.assign-gate-spool(SpoolPicker.gate, -1);
                        SpoolPicker.open = false;
                    }
                }
                IconButton {
                    icon: Icons.filament-spool;
                    text: @tr("Weigh");
                    horizontal: true;
                    enabled: root.selected >= 0;
                    clicked => {
                        weigh.text = "";
                        weigh.open = true;
                    }
                }
                IconButton {
                    icon: Icons.ui-check;
                    text: SpoolPicker.gate >= 0 ? @tr("Assign") : @tr("Use");
                    horizontal: true;
                    kind: "accent";
                    enabled: root.selected >= 0;
                    clicked => {
                        if (SpoolPicker.gate >= 0) {
                            Actions.assign-gate-spool(SpoolPicker.gate, root.selected);
                        } else {
                            Actions.set-active-spool(root.selected);
                        }
                        SpoolPicker.open = false;
                    }
                }
            }
        }
    }

    // The weight of the spool with its core, as the scale shows it; Spoolman subtracts the empty spool.
    weigh := TextEntryDialog {
        title: @tr("Weight of the spool in g, with the empty spool");
        accepted(text) => { Actions.measure-spool(root.selected, text); }
    }
}
