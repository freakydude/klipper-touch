// Overlays: confirmation, messages flyout, on-screen keyboard and text entry.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, Navigation, Page, Printer, TextTools } from "../state.slint";
import { IconButton, ScrollList } from "controls.slint";

// Dimming background that intercepts input meant for elements underneath.
component Scrim inherits Rectangle {
    background: #000000b0;
    TouchArea { }

    @children
}

export component ConfirmDialog inherits Scrim {
    visible: Confirm.open;

    Rectangle {
        width: min(parent.width - 80px, 480px);
        height: 220px;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Confirm.danger ? Theme.danger : Theme.border;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: Confirm.title;
                color: Theme.foreground;
                font-size: Theme.font-large;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: Confirm.message;
                color: Theme.muted;
                font-size: Theme.font-normal;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                spacing: 12px;
                IconButton {
                    icon: Icons.ui-back;
                    text: @tr("Back");
                    horizontal: true;
                    clicked => { Confirm.open = false; }
                }

                IconButton {
                    icon: Confirm.danger ? Icons.ui-warning : Icons.ui-check;
                    text: @tr("Confirm");
                    kind: Confirm.danger ? "danger" : "accent";
                    horizontal: true;
                    clicked => { Confirm.execute(); }
                }
            }
        }
    }
}

// Flyout below the status bar with all errors and informations, newest first. Tapping outside closes it.
export component MessagesFlyout inherits Rectangle {
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { Navigation.messages-open = false; }
    }

    Rectangle {
        x: root.width - self.width - 8px;
        y: 52px;
        width: min(560px, root.width - 16px);
        height: root.height - 60px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                height: 36px;
                text: @tr("Messages");
                color: Theme.foreground;
                font-size: Theme.font-large;
                vertical-alignment: center;
            }

            messages-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.messages-height;
                for message in Printer.messages: Rectangle {
                    x: 0;
                    y: message.top;
                    width: messages-list.row-width;
                    height: message.height;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Rectangle {
                            width: 4px;
                            background: message.is-error ? Theme.danger : Theme.info;
                            border-radius: 2px;
                        }
                        Text {
                            width: 60px;
                            text: message.time;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: message.text;
                            color: message.is-error ? Theme.danger : Theme.foreground;
                            font-size: Theme.font-normal;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    text: @tr("Discard all");
                    icon: Icons.ui-delete;
                    clicked => { Actions.messages-clear(); }
                }
                IconButton {
                    text: @tr("Console");
                    icon: Icons.nav-console;
                    kind: "accent";
                    clicked => {
                        Navigation.page = Page.console;
                        Navigation.messages-open = false;
                    }
                }
            }
        }
    }
}

component Key inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback pressed;
    min-width: 40px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: key-touch.pressed ? Theme.accent : Theme.surface-raised;
    accessible-role: button;
    accessible-label: root.label;

    key-touch := TouchArea {
        clicked => { root.pressed(); }
    }

    if root.icon.width > 0: Image {
        source: root.icon;
        colorize: Theme.foreground;
        width: 22px;
        height: 22px;
    }
    if root.icon.width == 0: Text {
        text: root.label;
        color: Theme.foreground;
        font-size: Theme.font-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// On-screen keyboard for devices without a physical keyboard; edits `text` directly.
export component OnScreenKeyboard inherits VerticalLayout {
    in-out property <string> text;
    in-out property <bool> upper: true;
    in-out property <bool> symbols;
    callback enter;

    property <[[string]]> lower-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "="],
        ["z", "x", "c", "v", "b", "n", "m", ".", "-", "_"],
    ];
    property <[[string]]> upper-rows: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L", "="],
        ["Z", "X", "C", "V", "B", "N", "M", ".", "-", "_"],
    ];
    property <[[string]]> symbol-rows: [
        ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"],
        ["+", "=", "?", "'", "\"", ",", ";", "<", ">", "|"],
        ["[", "]", "{", "}", "\\", "~", "`", "€", "§", "°"],
        ["ä", "ö", "ü", "ß", "Ä", "Ö", "Ü", ".", "-", "_"],
    ];

    spacing: 4px;

    for row in (root.symbols ? root.symbol-rows : root.upper ? root.upper-rows : root.lower-rows): HorizontalLayout {
        spacing: 4px;
        height: 40px;
        for key in row: Key {
            label: key;
            pressed => { root.text += key; }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        height: 40px;
        Key {
            label: root.upper ? "abc" : "ABC";
            horizontal-stretch: 2;
            pressed => {
                root.symbols = false;
                root.upper = !root.upper;
            }
        }

        Key {
            label: root.symbols ? "abc" : "#+=";
            horizontal-stretch: 2;
            pressed => { root.symbols = !root.symbols; }
        }

        Key {
            label: ":";
            pressed => { root.text += ":"; }
        }

        Key {
            label: "/";
            pressed => { root.text += "/"; }
        }

        Key {
            label: "space";
            horizontal-stretch: 3;
            pressed => { root.text += " "; }
        }

        Key {
            label: "backspace";
            icon: Icons.ui-chevron-left;
            horizontal-stretch: 2;
            pressed => { root.text = TextTools.remove-last(root.text); }
        }

        Key {
            label: "enter";
            icon: Icons.ui-check;
            horizontal-stretch: 2;
            pressed => { root.enter(); }
        }
    }
}

// Full-screen text entry with on-screen keyboard; `secret` hides the input (passwords).
export component TextEntryDialog inherits Scrim {
    in property <string> title;
    in property <bool> secret;
    in-out property <string> text;
    in-out property <bool> open;
    callback accepted(string);
    property <bool> reveal;
    visible: root.open;

    changed open => {
        if (root.open) { keys.focus(); }
    }

    // Modifier keys report a control character of their own; it must not end up in the text.
    pure function is-modifier(key: string) -> bool {
        key == Key.Shift || key == Key.ShiftR || key == Key.Control || key == Key.ControlR
            || key == Key.Alt || key == Key.AltGr || key == Key.CapsLock || key == Key.Meta || key == Key.MetaR
            || key == Key.Tab || key == Key.Backtab
    }

    // Physical keyboard (desktop, development): edits the same text as the on-screen keys.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.reveal = false;
                root.open = false;
                return accept;
            }
            if (event.text == Key.Return) {
                root.reveal = false;
                root.open = false;
                root.accepted(root.text);
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.text = TextTools.remove-last(root.text);
                return accept;
            }
            if (event.text.character-count == 1 && !root.is-modifier(event.text) && !event.modifiers.control && !event.modifiers.meta) {
                root.text += event.text;
                return accept;
            }
            reject
        }
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 48px;
                Text {
                    text: root.title;
                    color: Theme.muted;
                    font-size: Theme.font-normal;
                    vertical-alignment: center;
                    max-width: 260px;
                    overflow: elide;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.background;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: (root.secret && !root.reveal ? TextTools.mask(root.text) : root.text) + "|";
                        color: Theme.foreground;
                        font-size: Theme.font-large;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if root.secret: IconButton {
                    icon: root.reveal ? Icons.ui-unlock : Icons.ui-lock;
                    width: 56px;
                    checked: root.reveal;
                    accessible-label: @tr("Show password");
                    clicked => { root.reveal = !root.reveal; }
                }
                IconButton {
                    icon: Icons.ui-close;
                    width: 56px;
                    clicked => {
                        root.reveal = false;
                        root.open = false;
                    }
                }
            }

            OnScreenKeyboard {
                text <=> root.text;
                vertical-stretch: 1;
                enter => {
                    root.reveal = false;
                    root.open = false;
                    root.accepted(root.text);
                }
            }
        }
    }
}

// Parameters of a macro: one field per parameter, Klipper defaults as placeholders. Running asks for confirmation.
export component MacroFormDialog inherits Scrim {
    in-out property <bool> open;
    property <int> edit-index: -1;
    visible: root.open;

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 48px;
                Text {
                    horizontal-stretch: 1;
                    text: Printer.macro-form-name;
                    color: Theme.foreground;
                    font-size: Theme.font-large;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Each parameter is an input field: its name on the left, the value (or the Klipper default in grey) on the right.
            params-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.macro-form.length * (Theme.touch + Theme.spacing);
                for param[index] in Printer.macro-form: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: params-list.row-width - 16px;
                    height: Theme.touch;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: param.name;
                            color: Theme.foreground;
                            font-size: Theme.font-normal;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            horizontal-stretch: 2;
                            background: Theme.background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                x: 10px;
                                width: parent.width - 20px;
                                text: param.value != "" ? param.value : param.placeholder;
                                color: param.value != "" ? Theme.foreground : Theme.disabled-foreground;
                                font-size: Theme.font-normal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.edit-index = index;
                            edit.title = param.name;
                            edit.text = param.value;
                            edit.open = true;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    text: @tr("Cancel");
                    clicked => { root.open = false; }
                }
                IconButton {
                    text: @tr("Run");
                    icon: Icons.ui-check;
                    kind: "accent";
                    // Running is the confirmation: the user has just seen every parameter.
                    clicked => {
                        Actions.run-macro(Actions.macro-form-script());
                        root.open = false;
                    }
                }
            }
        }
    }

    edit := TextEntryDialog {
        accepted(text) => { Actions.set-macro-param(root.edit-index, text); }
    }
}

// Objects of the running print. Tapping one asks first; an excluded object cannot be printed again.
export component ExcludeObjectsDialog inherits Scrim {
    in-out property <bool> open;
    visible: root.open;

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                height: 48px;
                text: @tr("Exclude objects");
                color: Theme.foreground;
                font-size: Theme.font-large;
                vertical-alignment: center;
            }
            objects-list := ScrollList {
                vertical-stretch: 1;
                content-height: Printer.print-objects.length * (Theme.touch + Theme.spacing);
                for item[index] in Printer.print-objects: Rectangle {
                    x: 8px;
                    y: index * (Theme.touch + Theme.spacing);
                    width: objects-list.row-width - 16px;
                    height: Theme.touch;
                    background: item.excluded ? Theme.background : Theme.surface-raised;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: item.name;
                            color: item.excluded ? Theme.disabled-foreground : Theme.foreground;
                            font-size: Theme.font-normal;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: item.excluded ? @tr("Excluded") : "";
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        enabled: !item.excluded;
                        clicked => {
                            Confirm.ask(@tr("Exclude object"), item.name, "exclude-object", item.name, false);
                            root.open = false;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: Theme.touch;
                IconButton {
                    text: @tr("Close");
                    clicked => { root.open = false; }
                }
            }
        }
    }
}
