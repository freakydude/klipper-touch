// Sample data for previews (VS Code Slint preview, slint-viewer, scripts/ui-preview.ps1).
// Not part of the app: nothing in app.slint imports this folder. In the app, Rust fills these globals.

import { Navigation, Network, Page, Printer, UiSettings } from "../state.slint";

export global Sample {
    // Connected Voron-like printer, homed, nozzle and bed at temperature, no job.
    public function ready-printer() {
        Printer.connection = "connected";
        Printer.klippy-state = "ready";
        Printer.ready = true;
        Printer.endpoint = "http://voron.local:7125";
        Printer.clock = "14:32";
        Printer.activity = "ready";
        Printer.homed-x = true;
        Printer.homed-y = true;
        Printer.homed-z = true;
        Printer.position-x = 150;
        Printer.position-y = 150;
        Printer.position-z = 10;
        Printer.nozzle-temperature = 214.6;
        Printer.nozzle-target = 215;
        Printer.has-bed = true;
        Printer.bed-temperature = 59.8;
        Printer.bed-target = 60;
        Printer.has-part-fan = true;
        Printer.part-fan = 40;
        Printer.can-extrude = true;
        Printer.can-quad-gantry-level = true;
        Printer.has-probe = true;
        Printer.has-load-macro = true;
        Printer.has-unload-macro = true;
        Printer.has-power = true;
        Printer.has-update-manager = true;
        Printer.heaters = [
            {
                object: "extruder",
                label: "Nozzle",
                temperature: 214.6,
                target: 215,
                power: 0.42,
                can-raise: true
            },
            {
                object: "heater_bed",
                label: "Bed",
                temperature: 59.8,
                target: 60,
                power: 0.3,
                can-raise: true
            },
            {
                object: "heater_generic chamber",
                label: "Chamber",
                temperature: 38.2,
                target: 0,
                power: 0,
                can-raise: true
            },
        ];
        Printer.sensors = [{ label: "Raspberry Pi", temperature: 45 }];
        Printer.filament-sensors = [
            { label: "Toolhead Runout", enabled: true, detected: true },
            { label: "Extruder Encoder", enabled: true, detected: false },
        ];
        Printer.macros = ["PRINT_START", "PRINT_END", "LOAD_FILAMENT", "UNLOAD_FILAMENT", "PARK"];
        Printer.power-devices = [{ name: "printer", on: true, locked: true }, { name: "lights", on: false, locked: false }];
        Printer.updates = [
            { name: "klipper", version: "v0.13.0-100", detail: "20 commits behind", has-update: true },
            { name: "moonraker", version: "v0.9.3-50", detail: "up to date", has-update: false },
            { name: "mainsail", version: "v2.14.0", detail: "up to date", has-update: false },
        ];
        UiSettings.presets = [{ name: "PLA", extruder: 215, bed: 60 }, { name: "PETG", extruder: 240, bed: 80 }];
    }

    // Ready printer with a job at 37 %.
    // Happy Hare with four gates, one of them empty, and a sync-feedback buffer in tension.
    public function mmu() {
        self.ready-printer();
        Printer.has-mmu = true;
        Printer.mmu-homed = true;
        Printer.mmu-filament = "unloaded";
        Printer.mmu-action = "Idle";
        Printer.mmu-gate = 0;
        Printer.mmu-tool = 0;
        Printer.mmu-gates = [
            { index: 0, availability: "available", name: "Red PLA", material: "PLA", color: #e03131, has-color: true, tool: 0, selected: true },
            { index: 1, availability: "available", name: "Green PETG", material: "PETG", color: #37b24d, has-color: true, tool: 1, selected: false },
            { index: 2, availability: "buffered", name: "", material: "ABS", color: #4dabf7, has-color: true, tool: 2, selected: false },
            { index: 3, availability: "empty", name: "", material: "", color: #000000, has-color: false, tool: 3, selected: false },
        ];
        Printer.mmu-sensors = [
            { label: "Entry", state: "triggered" },
            { label: "Exit", state: "open" },
            { label: "Extruder", state: "open" },
            { label: "Toolhead", state: "open" },
        ];
        Printer.mmu-has-buffer = true;
        Printer.mmu-buffer-state = "tension";
        Printer.mmu-buffer-bias = -0.9;
        Printer.mmu-flowguard-state = "ready";
    }

    public function printing() {
        self.ready-printer();
        Printer.print-state = "printing";
        Printer.activity = "busy";
        Printer.filename = "benchy.gcode";
        Printer.job-name = "benchy";
        Printer.progress = 0.37;
        Printer.elapsed = "45:12";
        Printer.remaining = "1:16:40";
        Printer.eta = "15:49";
        Printer.layers = "74 / 200";
        Printer.filament = "1.92 m / 5.20 m";
        Printer.live-velocity = 182;
        Printer.live-flow = 11.4;
    }

    // Network tab of a printer host managed with NetworkManager.
    public function managed-network() {
        Network.managed = true;
        Network.local = true;
        Network.wifi-present = true;
        Network.wifi-enabled = true;
        Network.active-ssid = "Workshop";
        Network.wifi-address = "192.168.1.57";
        Network.networks = [
            {
                ssid: "Workshop",
                bars: 3,
                secured: true,
                supported: true,
                known: true,
                active: true,
                in-range: true
            },
            {
                ssid: "Cafe Guest",
                bars: 2,
                secured: false,
                supported: true,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Garage",
                bars: 2,
                secured: true,
                supported: true,
                known: true,
                active: false,
                in-range: true
            },
            {
                ssid: "Office",
                bars: 1,
                secured: true,
                supported: false,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Neighbour",
                bars: 1,
                secured: true,
                supported: true,
                known: false,
                active: false,
                in-range: true
            },
            {
                ssid: "Holiday Flat",
                bars: 0,
                secured: false,
                supported: true,
                known: true,
                active: false,
                in-range: false
            },
        ];
        Network.wired = [{ interface: "eth0", cable: true, connected: true, address: "192.168.1.42" }];
        Navigation.page = Page.settings;
        Navigation.settings-tab = 1;
    }
}
