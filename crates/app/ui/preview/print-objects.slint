// Preview: objects of a running print in the exclude dialog, one of them already excluded. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { ExcludeObjectsDialog } from "../components/overlays.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintObjectsPreview inherits AppWindow {
    ExcludeObjectsDialog {
        open: true;
    }

    init => {
        Sample.printing();
        Navigation.page = Page.print;
        Printer.print-objects = [
            { name: "BENCHY_0", excluded: false },
            { name: "BENCHY_1", excluded: true },
            { name: "CALIBRATION_CUBE", excluded: false },
            { name: "SUPPORT_TOWER", excluded: false },
        ];
    }
}
