// Preview: print page of a running print with Happy Hare (strip with tool, gate, buffer and FlowGuard). Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintMmuPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Sample.printing();
        Navigation.page = Page.print;
        Printer.mmu-gate = 2;
        Printer.mmu-tool = 2;
        Printer.mmu-filament = "loaded";
        Printer.mmu-buffer-state = "neutral";
        Printer.mmu-buffer-bias = 0.08;
        Printer.mmu-flowguard-state = "monitoring";
        Printer.mmu-flow-rate = 99;
    }
}
