// Main window: status bar, navigation, current page and overlays.

import { Theme } from "theme.slint";
import { Actions, Confirm, Dialogs, Navigation, Network, Page, Printer, SpoolPicker, StateIcons, UiSettings } from "state.slint";
import { NavRail, StatusBar } from "components/chrome.slint";
import { ConfirmDialog, MessagesFlyout, SpoolDialog } from "components/overlays.slint";
import { HistoryDialog } from "components/history.slint";
import { LightPanel } from "components/light.slint";
import { PrintPage } from "pages/print.slint";
import { MovePage } from "pages/move.slint";
import { TemperaturePage } from "pages/temperature.slint";
import { TunePage } from "pages/tune.slint";
import { FilamentPage } from "pages/filament.slint";
import { ConsolePage } from "pages/console.slint";
import { SystemPage } from "pages/system.slint";
import { UpdatesPage } from "pages/updates.slint";
import { SettingsPage } from "pages/settings.slint";
import { NetworkPage } from "pages/network-page.slint";
import { ConnectionPage } from "pages/connection.slint";

export { Actions, Confirm, Navigation, Network, Page, Printer, SpoolPicker, UiSettings }
export { ChartLabel, FilamentPathItem, FileItem, HeaterItem, SensorItem, FanItem, LedItem, LedEffectItem, TuningItem, FilamentSensorItem, MmuGateItem, MmuSensorItem, SpoolItem, PrintObjectItem, BedMapItem, ConsoleItem, MessageItem, MacroItem, MacroParamItem, PowerItem, UpdateItem, PresetItem, WifiItem, WiredItem, HostInterfaceItem } from "state.slint";

export component AppWindow inherits Window {
    title: "FreakyMate";
    preferred-width: 800px;
    preferred-height: 480px;
    // The layout is made for 800x480 and needs that room: a window is never smaller, only larger. Fullscreen fits
    // the layout to any display instead (`display.rs`).
    min-width: 800px;
    min-height: 480px;
    background: Theme.background;
    default-font-size: Theme.font-normal;

    // Pages that are useful even without a ready printer.
    property <bool> page-works-offline: Navigation.page == Page.system || Navigation.page == Page.settings
        || Navigation.page == Page.network
        || ((Navigation.page == Page.console || Navigation.page == Page.updates) && Printer.connection == "connected");
    property <bool> network-visible: Navigation.page == Page.network;
    property <bool> printer-ready: Printer.ready;

    changed network-visible => { Network.watch(self.network-visible); }
    // Without Moonraker or Klipper the dialogs of the printer pages no longer apply; they close like a cancel. The
    // pages that work offline keep theirs (Moonraker address, Wi-Fi password).
    changed printer-ready => {
        if (!self.printer-ready && !self.page-works-offline) { Dialogs.dismiss(); }
    }

    VerticalLayout {
        StatusBar { }
        HorizontalLayout {
            vertical-stretch: 1;
            NavRail { }
            Rectangle {
                horizontal-stretch: 1;
                if Navigation.page == Page.print: PrintPage { }
                if Navigation.page == Page.move: MovePage { }
                if Navigation.page == Page.temperature: TemperaturePage { }
                if Navigation.page == Page.tune: TunePage { }
                if Navigation.page == Page.filament: FilamentPage { }
                if Navigation.page == Page.console: ConsolePage { }
                if Navigation.page == Page.system: SystemPage { }
                if Navigation.page == Page.updates: UpdatesPage { }
                if Navigation.page == Page.settings: SettingsPage { }
                if Navigation.page == Page.network: NetworkPage { }
                if !Printer.ready && !root.page-works-offline: ConnectionPage { }
                // Dialogs cover only the content area: the status bar and the navigation stay usable, and a tap
                // there cancels the dialog (`Dialogs.dismiss`).
                HistoryDialog { }
                SpoolDialog { }
                ConfirmDialog { }
            }
        }
    }

    if Navigation.light-open: LightPanel {
        width: parent.width;
        height: parent.height;
    }

    if Navigation.messages-open: MessagesFlyout {
        width: parent.width;
        height: parent.height;
    }
}
