// Service tab of the Filament page: check and preload the gates one by one, and the commands for the MMU itself
// (home, recover, unlock, motors off, selector servo) that are rarely needed during normal use.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Actions, Confirm, MmuGateItem, Printer } from "../state.slint";
import { ColorBar, IconButton, ScrollList } from "../components/controls.slint";
import { GateAvailabilityLabel } from "mmu.slint";

// Happy Hare unloads loaded filament before it checks another gate, and loads it again afterwards outside a print.
global GateCheck {
    pure public function unloads-first(gate: int) -> bool {
        return Printer.mmu-filament != "unloaded" && gate != Printer.mmu-gate;
    }

    public function ask(title: string, action: string, argument: string) {
        Confirm.ask(title, @tr("Happy Hare unloads the loaded filament first and, outside a print, loads it again afterwards."), action, argument, false);
    }
}

component GateServiceRow inherits Rectangle {
    in property <MmuGateItem> gate;

    background: row-touch.pressed ? Theme.surface-active : Theme.surface;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: @tr("Gate {}", root.gate.index);

    // A tap on the row selects the gate, as on the MMU tab; the buttons lie above and keep their taps.
    row-touch := TouchArea {
        clicked => { Actions.mmu-select-gate(root.gate.index); }
    }

    HorizontalLayout {
        padding-left: 10px;
        spacing: Theme.spacing;
        ColorBar {
            width: 8px;
            height: root.height - 20px;
            cross-axis-self-alignment: center;
            border-radius: 4px;
            vertical: true;
            first: root.gate.has-color ? root.gate.color : Theme.border;
            second: root.gate.color-2;
            third: root.gate.color-3;
            count: max(1, root.gate.color-count);
            longitudinal: root.gate.longitudinal;
        }
        VerticalLayout {
            width: 116px;
            alignment: center;
            Text {
                text: root.gate.tool >= 0 ? @tr("Gate {} · T{}", root.gate.index, root.gate.tool) : @tr("Gate {}", root.gate.index);
                color: Theme.foreground;
                font-size: Theme.font-normal;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.gate.material == "" ? "-" : root.gate.material;
                color: Theme.muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        GateAvailabilityLabel {
            horizontal-stretch: 1;
            cross-axis-self-alignment: center;
            availability: root.gate.availability;
        }
        IconButton {
            width: 72px;
            icon: Icons.mmu-check-gate;
            text: @tr("Check");
            clicked => {
                if (GateCheck.unloads-first(root.gate.index)) {
                    GateCheck.ask(@tr("Check gate {}", root.gate.index), "mmu-check-gate", root.gate.index);
                } else {
                    Actions.mmu-check-gate(root.gate.index);
                }
            }
        }
        IconButton {
            width: 72px;
            icon: Icons.mmu-preload;
            text: @tr("Preload");
            // Happy Hare refuses to preload while printing.
            enabled: Printer.print-state != "printing";
            clicked => { Actions.mmu-preload(root.gate.index); }
        }
    }

    // The frame of the selected gate lies above the buttons, which reach the edge of the row.
    if root.gate.selected: Rectangle {
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

export component MmuServiceTab inherits Rectangle {
    property <length> button-height: 100px;

    HorizontalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing;

            gate-list := ScrollList {
                property <length> row-height: Theme.touch;
                property <length> row-spacing: 6px;
                vertical-stretch: 1;
                content-height: Printer.mmu-gates.length * (self.row-height + self.row-spacing) - self.row-spacing;
                for gate[index] in Printer.mmu-gates: GateServiceRow {
                    y: index * (gate-list.row-height + gate-list.row-spacing);
                    width: gate-list.row-width;
                    height: gate-list.row-height;
                    gate: gate;
                }
            }
            IconButton {
                icon: Icons.mmu-check-gate;
                text: @tr("Check all gates");
                horizontal: true;
                vertical-stretch: 0;
                clicked => {
                    if (Printer.mmu-filament != "unloaded") {
                        GateCheck.ask(@tr("Check all gates"), "mmu-check-all-gates", "");
                    } else {
                        Actions.mmu-check-all-gates();
                    }
                }
            }
        }

        VerticalLayout {
            width: 240px;
            spacing: Theme.spacing;
            HorizontalLayout {
                spacing: Theme.spacing;
                height: root.button-height;
                IconButton {
                    icon: Icons.mmu-home;
                    text: @tr("Home");
                    kind: Printer.mmu-homed ? "normal" : "accent";
                    clicked => { Actions.mmu-home(); }
                }
                IconButton {
                    icon: Icons.mmu-recover;
                    text: @tr("Recover");
                    kind: Printer.mmu-paused ? "accent" : "normal";
                    clicked => { Actions.mmu-recover(); }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                height: root.button-height;
                IconButton {
                    icon: Icons.ui-unlock;
                    text: @tr("Unlock");
                    kind: Printer.mmu-locked ? "accent" : "normal";
                    clicked => { Actions.mmu-unlock(); }
                }
                IconButton {
                    icon: Icons.motion-steppers-off;
                    text: @tr("Motors off");
                    clicked => {
                        Confirm.ask(@tr("MMU motors off"), @tr("The MMU can be moved by hand; the selector loses its position and must be homed again."), "mmu-motors-off", "", false);
                    }
                }
            }
            if Printer.mmu-servo != "": HorizontalLayout {
                spacing: Theme.spacing;
                height: root.button-height;
                IconButton {
                    icon: Icons.mmu-servo-up;
                    text: @tr("Servo up");
                    checked: Printer.mmu-servo == "up";
                    clicked => { Actions.mmu-servo-up(); }
                }
                IconButton {
                    icon: Icons.mmu-servo-down;
                    text: @tr("Servo down");
                    checked: Printer.mmu-servo == "down";
                    clicked => { Actions.mmu-servo-down(); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
