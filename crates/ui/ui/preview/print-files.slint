// Preview: the file list with facts as icons. Rows: with thumbnail, with estimates and chamber temperature, without
// thumbnail, metadata not loaded yet (placeholder). Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintFilesPreview inherits AppWindow {
    init => {
        Sample.ready-printer();
        Navigation.page = Page.print;
        Navigation.files-open = true;
        Printer.files = [
            {
                path: "benchy.gcode",
                name: "benchy",
                modified: "17.11.2023 06:46",
                material: "PLA 52 g",
                nozzle: "0.4",
                time: "2h 07m",
                extruder-temperature: "215°",
                bed-temperature: "60°",
                thumbnail: @image-url("../../../../assets/icons/state/state-printing.svg"),
                has-thumbnail: true,
                show-thumbnail: true,
            },
            {
                path: "long_job.gcode",
                name: "long_job",
                modified: "16.11.2023 03:00",
                material: "PETG ~270 g",
                nozzle: "0.6",
                time: "~10h 00m",
                extruder-temperature: "240°",
                bed-temperature: "80°",
                chamber-temperature: "45°",
                show-thumbnail: true,
            },
            {
                path: "calibration_cube_with_a_rather_long_name.gcode",
                name: "calibration_cube_with_a_rather_long_name",
                modified: "14.11.2023 23:13",
                material: "ABS 11 g",
                nozzle: "0.4",
                time: "23m 00s",
                extruder-temperature: "250°",
                bed-temperature: "105°",
                show-thumbnail: false,
            },
            {
                path: "plain.gcode",
                name: "plain",
                modified: "10.11.2023 18:20",
                show-thumbnail: true,
            },
        ];
    }
}
