// Preview: service tab of an ERCF with eight gates and a servo selector, not homed after the motors were off. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuServicePreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = 2;
        Printer.mmu-homed = false;
        Printer.mmu-servo = "up";
        Printer.mmu-gate = 1;
        Printer.mmu-gates = [
            { index: 0, availability: "available", name: "Red PLA", material: "PLA", color: #e03131, has-color: true, color-count: 1, tool: 0, selected: false },
            { index: 1, availability: "available", name: "Green PETG", material: "PETG", color: #37b24d, has-color: true, color-count: 1, tool: 1, selected: true },
            { index: 2, availability: "buffered", name: "", material: "ABS", color: #4dabf7, has-color: true, color-count: 1, tool: 2, selected: false },
            { index: 3, availability: "empty", name: "", material: "", color: #000000, has-color: false, tool: 3, selected: false },
            { index: 4, availability: "available", name: "Black ASA", material: "ASA", color: #212529, has-color: true, color-count: 1, tool: 4, selected: false },
            { index: 5, availability: "available", name: "Natural PLA", material: "PLA", color: #f1f3f5, has-color: true, color-count: 1, tool: -1, selected: false },
            { index: 6, availability: "unknown", name: "", material: "", color: #000000, has-color: false, tool: -1, selected: false },
            { index: 7, availability: "empty", name: "", material: "", color: #000000, has-color: false, tool: 7, selected: false },
        ];
    }
}
