// Preview: dialog of a gate without Spoolman, with material and colour from Happy Hare's gate map. Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { MmuDialogs, Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component FilamentMmuGateDialogPreview inherits AppWindow {
    init => {
        Sample.mmu();
        Navigation.page = Page.filament;
        Navigation.filament-tab = 1;
        Printer.has-spoolman = false;
        Printer.mmu-gates = [
            { index: 0, availability: "available", name: "Red PLA", material: "PLA", color: #ff0000, has-color: true, color-count: 1, tool: 0, selected: true },
            { index: 1, availability: "available", name: "", material: "PETG", color: #ff8000, has-color: true, color-count: 1, tool: 1, selected: false },
            { index: 2, availability: "empty", name: "", material: "", color: #000000, has-color: false, tool: 2, selected: false },
        ];
        MmuDialogs.gate = 1;
    }
}
