// Preview: print page while tangle prevention raises the gear current (FlowGuard line in yellow). Open in the Slint preview or render with scripts/ui-preview.sh.

import { AppWindow } from "../app.slint";
import { Navigation, Page, Printer } from "../state.slint";
import { Sample } from "sample.slint";

export component PrintMmuTanglePreview inherits AppWindow {
    init => {
        Sample.mmu();
        Sample.printing();
        Navigation.page = Page.print;
        Printer.mmu-gate = 2;
        Printer.mmu-tool = 2;
        Printer.mmu-filament = "loaded";
        Printer.mmu-buffer-state = "tension";
        Printer.mmu-buffer-bias = -0.93;
        Printer.mmu-flowguard-state = "boosting";
        Printer.mmu-flow-rate = 98;
    }
}
