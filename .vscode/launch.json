{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: freakymate (fake Moonraker)",
      "cargo": {
        "args": ["build", "-p", "freakymate", "--bin", "freakymate"]
      },
      "args": ["--moonraker", "http://127.0.0.1:7125"],
      "env": { "RUST_LOG": "info,freakymate_core=debug" },
      "preLaunchTask": "run: fake-moonraker"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: freakymate (fake Moonraker, Happy Hare)",
      "cargo": {
        "args": ["build", "-p", "freakymate", "--bin", "freakymate"]
      },
      "args": ["--moonraker", "http://127.0.0.1:7125"],
      "env": { "RUST_LOG": "info,freakymate_core=debug" },
      "preLaunchTask": "run: fake-moonraker (Happy Hare)"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: freakymate (saved settings)",
      "cargo": {
        "args": ["build", "-p", "freakymate", "--bin", "freakymate"]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: fake-moonraker",
      "cargo": {
        "args": ["build", "-p", "fake-moonraker"]
      },
      "args": ["--port", "7125", "--time-scale", "10", "--profile", "voron"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: fake-moonraker (Happy Hare)",
      "cargo": {
        "args": ["build", "-p", "fake-moonraker"]
      },
      "args": ["--port", "7125", "--time-scale", "10", "--profile", "happy-hare", "--gates", "8"]
    }
  ]
