{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: klipper-touch (fake Moonraker)",
      "cargo": {
        "args": ["build", "-p", "klipper-touch", "--bin", "klipper-touch"]
      },
      "args": ["--moonraker", "http://127.0.0.1:7125"],
      "env": { "RUST_LOG": "info,klipper_touch_core=debug" },
      "preLaunchTask": "run: fake-moonraker"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: klipper-touch (saved settings)",
      "cargo": {
        "args": ["build", "-p", "klipper-touch", "--bin", "klipper-touch"]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "debug: fake-moonraker",
      "cargo": {
        "args": ["build", "-p", "fake-moonraker"]
      },
      "args": ["--port", "7125", "--time-scale", "10", "--profile", "voron"]
    }
  ]
}
