{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      }
    },
    {
      "label": "ui:build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"]
    },
    {
      "label": "fake-moonraker",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--manifest-path", "fake-moonraker/Cargo.toml"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "fake-moonraker",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Fake-Moonraker listening"
        }
      }
    },
    {
      "label": "dev:fake",
      "dependsOn": ["ui:dev", "fake-moonraker"],
      "dependsOrder": "parallel"
    }
  ]
}
