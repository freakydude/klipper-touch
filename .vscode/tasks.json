{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run: fake-moonraker",
      "type": "shell",
      "command": "cargo run -p fake-moonraker -- --port 7125 --time-scale 10 --profile voron",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "^.*(Compiling|Finished|Running).*$",
          "endsPattern": "^Fake-Moonraker listening.*$"
        }
      }
    },
    {
      "label": "run: klipper-touch (fake Moonraker)",
      "type": "shell",
      "command": "cargo run -p klipper-touch -- --moonraker http://127.0.0.1:7125",
      "dependsOn": "run: fake-moonraker",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "run: klipper-touch (saved settings)",
      "type": "shell",
      "command": "cargo run -p klipper-touch",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "ui-snapshot",
      "type": "shell",
      "command": "powershell -File scripts\\ui-snapshot.ps1",
      "problemMatcher": []
    },
    {
      "label": "icon-index",
      "type": "shell",
      "command": "cargo run -p icon-index",
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets; cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    }
  ]
}
