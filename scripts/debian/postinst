#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  echo "freakymate installed. Start it in kiosk mode on tty1 for user <name>:"
  echo "  sudo systemctl enable --now freakymate@<name>"
  echo "Wi-Fi settings need NetworkManager and membership in the group netdev:"
  echo "  sudo usermod -aG netdev <name>"
fi
