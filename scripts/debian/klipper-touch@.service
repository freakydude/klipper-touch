[Unit]
Description=klipper-touch touch UI for Klipper (user %i)
After=systemd-user-sessions.service network-online.target moonraker.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
ExecStart=/usr/bin/cage -s -- /usr/bin/klipper-touch --fullscreen
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
